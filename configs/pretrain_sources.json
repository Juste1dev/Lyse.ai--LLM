      "max_docs": 50000
    },
    {
      "name": "custom_jsonl_texts",
      "type": "local_jsonl_text",
      "glob": "data/custom_pretrain/**/*.jsonl",
      "text_key": "text",
      "max_docs": 50000
    }
  ]
}
