{
  "sources": [
    {
      "name": "fineweb_edu_general",
      "type": "fineweb_edu",
      "dataset": "HuggingFaceFW/fineweb-edu",
      "split": "train",
      "max_docs": 250000
    },
    {
      "name": "culturax_fr",
